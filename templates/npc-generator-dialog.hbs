<form class="npc-generator-form">
  <fieldset>
    <legend>{{token.label}}</legend>
    <div class="npc-generator-select-field">
      <div class="npc-generator-field-control">
        <label for="npc-generator-token-disposition">{{token.label}}</label>
        <select id="npc-generator-token-disposition" name="tokenDisposition">
          {{#each token.options}}
            <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </div>
      <p class="notes">{{token.help}}</p>
    </div>
  </fieldset>

  {{#each groups}}
    <fieldset>
      <legend>{{label}}</legend>

      {{#each fields}}
        {{#if boolean}}
          <div class="npc-generator-checkbox-field">
            <label class="checkbox">
              <input type="checkbox" name="{{name}}" {{#if checked}}checked{{/if}}>
              <span>{{label}}</span>
            </label>
            <p class="notes">{{help}}</p>
          </div>
        {{else}}
          {{#if hasChoices}}
            <div class="npc-generator-select-field">
              <div class="npc-generator-field-control">
                <label for="npc-generator-{{id}}">{{label}}</label>
              <select id="npc-generator-{{id}}" name="{{name}}">
                {{#if nullable}}
                  <option value="" {{#if nullSelected}}selected{{/if}}>{{randomLabel}}</option>
                {{/if}}
                {{#each choices}}
                  <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
                {{/each}}
              </select>
              </div>
              <p class="notes">{{help}}</p>
            </div>
          {{else}}
            <div class="form-group" title="{{help}}">
              <label for="npc-generator-{{id}}">{{label}}</label>
              <input
                id="npc-generator-{{id}}"
                name="{{name}}"
                type="{{inputType}}"
                value="{{value}}"
                {{#if integer}}step="1"{{/if}}
                {{#if password}}autocomplete="off"{{/if}}
              >
              <p class="notes">{{help}}</p>
            </div>
          {{/if}}
        {{/if}}
      {{/each}}
    </fieldset>
  {{/each}}
</form>
