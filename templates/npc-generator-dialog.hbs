<form class="npc-generator-form">
  <fieldset>
    <legend>{{npcCustomization}}</legend>

    <div class="form-group">
      <label for="npc-generator-rank">{{rankLabel}}</label>
      <select id="npc-generator-rank" name="rank">
        {{#each ranks}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="form-group">
      <label for="npc-generator-role">{{roleLabel}}</label>
      <select id="npc-generator-role" name="role">
        {{#each roles}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="form-group">
      <label for="npc-generator-nationality">{{nationalityLabel}}</label>
      <select id="npc-generator-nationality" name="nationality">
        <option value="" selected>{{randomLabel}}</option>
        {{#each nationalities}}
          <option value="{{value}}">{{label}}</option>
        {{/each}}
      </select>
    </div>

    <div class="npc-generator-checkboxes">
      {{#each booleanOptions}}
        <label class="checkbox">
          <input type="checkbox" name="{{name}}" {{#if checked}}checked{{/if}}>
          <span>{{label}}</span>
        </label>
      {{/each}}
    </div>
  </fieldset>

  <fieldset>
    <legend>{{generationSettings}}</legend>

    <div class="form-group">
      <label for="npc-generator-seed">{{seedLabel}}</label>
      <input id="npc-generator-seed" name="seed" type="number" value="0" step="1">
    </div>

    <div class="form-group">
      <label for="npc-generator-model-id">{{modelIdLabel}}</label>
      <input id="npc-generator-model-id" name="model-id" type="text" value="qwen/qwen3.6-35b-a3b">
    </div>

    <div class="form-group">
      <label for="npc-generator-model-api-key">{{modelApiKeyLabel}}</label>
      <input id="npc-generator-model-api-key" name="model-api-key" type="password" value="lm-studio" autocomplete="off">
    </div>

    <div class="form-group">
      <label for="npc-generator-model-base-url">{{modelBaseUrlLabel}}</label>
      <input id="npc-generator-model-base-url" name="model-base-url" type="url" value="http://localhost:1234/v1">
    </div>

    <div class="form-group">
      <label for="npc-generator-model-language">{{modelLanguageLabel}}</label>
      <input id="npc-generator-model-language" name="model-language" type="text" value="English">
    </div>
  </fieldset>

</form>
